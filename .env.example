# Copy this file to .env (git-ignored) and change every value:  cp .env.example .env
# SQL Server rejects weak passwords: use at least 8 characters with upper case, lower case and a digit.

# The SQL Server administrator (only used by db-init to create the databases and logins).
SA_PASSWORD=Change_me_Sa_1

# One login per service; each can only open its own databases.
SUBSCRIPTIONS_DB_PASSWORD=Change_me_Subs_1
BUDGETS_DB_PASSWORD=Change_me_Budgets_1

# The key that stamps login tokens. Both services get the same one. Any long random text.
SECRET_KEY=change-me-to-a-long-random-text
